# ──────────────────────────────────────────
# Database
# ──────────────────────────────────────────
MYSQL_DATABASE=appdb
MYSQL_USER=appuser
MYSQL_PASSWORD=apppass
MYSQL_ROOT_PASSWORD=rootpass

# ──────────────────────────────────────────
# Application
# ──────────────────────────────────────────
APP_URL=http://localhost:8000
APP_ENV=development

# ──────────────────────────────────────────
# Google OAuth 2.0
# ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/login/google/callback
