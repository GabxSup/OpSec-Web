{
    "name": "gabx/encrypted-login",
    "description": "Secure PHP Login System",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3.36"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "classmap": [
            "www/models/",
            "www/core/",
            "www/controllers/",
            "www/helpers/"
        ]
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml",
        "test:coverage": "phpunit --configuration phpunit.xml --coverage-text"
    }
}